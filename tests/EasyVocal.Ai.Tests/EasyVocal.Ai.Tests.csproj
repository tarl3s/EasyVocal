<Project Sdk="Microsoft.NET.Sdk">

  <!-- The AI voices' engine on any OS. Tests that need the real models (HuBERT, RMVPE, the RVC base generator, all
       MIT from RVC's Hugging Face repository) download them once into a cache folder (EV_AI_MODELS, else
       %TEMP%\EV_AiModelCache), build an AI pack from them and report "SKIPPED" when that isn't possible
       (EV_AI_OFFLINE=1, no network). The rest uses the tiny fixtures in Fixtures/ (tools/ai/export/make_fixtures.py). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EasyVocal.Ai\EasyVocal.Ai.csproj" />
    <ProjectReference Include="..\..\src\EasyVocal.Core\EasyVocal.Core.csproj" />
  </ItemGroup>

  <Import Project="..\..\src\EasyVocal.Ai\OnnxRuntime.Native.props" />

  <ItemGroup>
    <!-- Shared with the portable tests: real speech (Windows TTS, else a synthetic vowel), signals, WAV, folders, fake devices. -->
    <Compile Include="..\EasyVocal.Tests\Helpers\Speech.cs" Link="Helpers\Speech.cs" />
    <Compile Include="..\EasyVocal.Tests\Helpers\Signals.cs" Link="Helpers\Signals.cs" />
    <Compile Include="..\EasyVocal.Tests\Helpers\WavFile.cs" Link="Helpers\WavFile.cs" />
    <Compile Include="..\EasyVocal.Tests\Helpers\TestFolders.cs" Link="Helpers\TestFolders.cs" />
    <Compile Include="..\EasyVocal.Tests\Helpers\FakeAudio.cs" Link="Helpers\FakeAudio.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Fixtures" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
