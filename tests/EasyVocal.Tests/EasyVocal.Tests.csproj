<Project Sdk="Microsoft.NET.Sdk">

  <!-- The portable tests: Core only, so `dotnet test` runs them on Windows, macOS and Linux.
       Windows-only tests (WASAPI, Media Foundation, registry, .lnk, Authenticode, PowerShell, the e2e run) are in
       EasyVocal.Tests.Windows. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EasyVocal.Core\EasyVocal.Core.csproj" />
    <!-- Built first, not referenced: DecoderTests runs it in place of ffmpeg (from its own bin folder). -->
    <ProjectReference Include="..\EasyVocal.FfmpegStandIn\EasyVocal.FfmpegStandIn.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plain classes of the app (no UI), compiled here so they can be tested without referencing the app. -->
    <Compile Include="..\..\src\EasyVocal\AppArgs.cs" Link="Linked\AppArgs.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Small decoder fixtures (a 440 Hz tone): MP3 made with Windows' encoder, OGG with OggVorbisEncoder. -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Fixtures" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
