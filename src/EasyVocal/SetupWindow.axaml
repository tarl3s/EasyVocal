<loc:AppWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:loc="using:EasyVocal"
               x:Class="EasyVocal.SetupWindow"
               Title="{loc:T 'EasyVocal setup'}" Width="540" SizeToContent="Height" MinWidth="440" MinHeight="380"
               WindowStartupLocation="CenterOwner">
    <loc:AppWindow.Styles>
        <!-- A numbered step's card. -->
        <Style Selector="Border.step">
            <Setter Property="Background" Value="{StaticResource Bg1}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style Selector="Border.number">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Border.number > TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AccentText}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.stepTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </loc:AppWindow.Styles>
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,8">
                <TextBlock Text="{loc:T 'Set up EasyVocal'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                <TextBlock Text="{loc:T 'Three quick steps, then you are ready for your calls.'}" Classes="dim" Margin="0,2,0,4"
                           TextWrapping="Wrap" />

                <!-- 1. Virtual microphone -->
                <Border Classes="step" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Classes="number"><TextBlock Text="1" /></Border>
                            <TextBlock Text="{loc:T 'Virtual microphone'}" Classes="stepTitle" />
                        </StackPanel>

                        <StackPanel x:Name="CableReadyPanel" Orientation="Horizontal" Margin="0,10,0,0" IsVisible="False">
                            <TextBlock Text="✅" Classes="emoji" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:T 'Virtual microphone ready'}" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel x:Name="CableMissingPanel" Margin="0,10,0,0">
                            <TextBlock x:Name="CableExplanation" TextWrapping="Wrap" />
                            <DockPanel Margin="0,10,0,0" LastChildFill="True">
                                <Button x:Name="InstallButton" DockPanel.Dock="Left" Theme="{StaticResource AccentButton}" MinWidth="96"
                                        Content="{loc:T 'Install'}" Click="InstallButton_Click" />
                                <Border x:Name="ProgressTrack" Height="8" CornerRadius="4" Background="{StaticResource Bg2}" Margin="12,0,0,0"
                                        VerticalAlignment="Center" IsVisible="False">
                                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="4"
                                            Background="{StaticResource Accent}" />
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="CableStatus" IsVisible="False" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. Your microphone -->
                <Border Classes="step">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Classes="number"><TextBlock Text="2" /></Border>
                            <TextBlock Text="{loc:T 'Your microphone'}" Classes="stepTitle" />
                        </StackPanel>
                        <ComboBox x:Name="MicBox" Margin="0,10,0,0" SelectionChanged="MicBox_SelectionChanged" />
                        <TextBlock x:Name="NoMicText" IsVisible="False" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Warn}"
                                   Text="{loc:T 'No microphone found. Plug one in and it will show up here.'}" />
                        <Border x:Name="MeterTrack" Height="8" CornerRadius="4" Background="{StaticResource Bg2}" Margin="0,12,0,0"
                                ToolTip.Tip="{loc:T 'Your microphone level'}">
                            <Border x:Name="MeterBar" HorizontalAlignment="Left" Width="0" CornerRadius="4" Background="{StaticResource MeterFill}" />
                        </Border>
                        <TextBlock Text="{loc:T 'Say something: the bar should move.'}" Classes="dim small" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 3. Choose it in your app -->
                <Border Classes="step">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Classes="number"><TextBlock Text="3" /></Border>
                            <TextBlock Text="{loc:T 'Choose it in your app'}" Classes="stepTitle" />
                        </StackPanel>
                        <TabControl x:Name="GuideTabs" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <CheckBox x:Name="StartBox" Margin="2,14,0,0" Content="{loc:T 'Start with Windows (recommended)'}" />
                <TextBlock Text="{loc:T 'EasyVocal then starts hidden in the tray, so your voice is ready for every call.'}"
                           Classes="dim small" Margin="28,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="20,8,20,16" LastChildFill="False">
            <Button x:Name="DoneButton" DockPanel.Dock="Right" MinWidth="96" Theme="{StaticResource AccentButton}"
                    Content="{loc:T 'Done'}" IsDefault="True" Click="DoneButton_Click" />
        </DockPanel>
    </Grid>
</loc:AppWindow>
