<loc:AppWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:loc="using:EasyVocal"
               x:Class="EasyVocal.SettingsWindow"
               Title="{loc:T 'Settings'}" Width="520" SizeToContent="Height" MinWidth="420" MinHeight="340"
               ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,8">
                <TextBlock Text="{loc:T 'Audio'}" Classes="section" />

                <TextBlock Text="{loc:T 'Microphone'}" Classes="label" Margin="0,10,0,0" />
                <ComboBox x:Name="MicBox" Margin="0,6,0,0" SelectionChanged="MicBox_SelectionChanged" />
                <TextBlock x:Name="MicProblem" IsVisible="False" TextWrapping="Wrap" Foreground="{StaticResource Danger}" Margin="0,6,0,0" />

                <TextBlock Text="{loc:T 'Call output'}" Classes="label" Margin="0,14,0,0" />
                <ComboBox x:Name="OutputBox" Margin="0,6,0,0" SelectionChanged="OutputBox_SelectionChanged" />
                <TextBlock x:Name="OutputHint" Classes="dim small" TextWrapping="Wrap" Margin="0,4,0,0" />

                <TextBlock Text="{loc:T 'Headphones for “Hear me”'}" Classes="label" Margin="0,14,0,0" />
                <ComboBox x:Name="MonitorBox" Margin="0,6,0,0" SelectionChanged="MonitorBox_SelectionChanged" />

                <TextBlock Text="{loc:T 'General'}" Classes="section" Margin="0,22,0,0" />

                <TextBlock Text="{loc:T 'Language'}" Classes="label" Margin="0,10,0,0" />
                <ComboBox x:Name="LanguageBox" Margin="0,6,0,0" SelectionChanged="LanguageBox_SelectionChanged" />
                <TextBlock x:Name="LanguageNote" Text="{loc:T 'The language changes the next time you open EasyVocal.'}"
                           Classes="dim small" TextWrapping="Wrap" Margin="0,4,0,0" />

                <CheckBox x:Name="StartBox" Margin="0,16,0,0" Click="StartBox_Click" /> <!-- its text names the system: set in code -->
                <CheckBox x:Name="AskQuitBox" Margin="0,10,0,0" Content="{loc:T 'Ask before quitting'}" Click="AskQuitBox_Click" />

                <CheckBox x:Name="UpdateBox" Margin="0,10,0,0" Content="{loc:T 'Check for updates when EasyVocal opens'}" Click="UpdateBox_Click" />
                <DockPanel Margin="0,10,0,0" LastChildFill="True">
                    <Button x:Name="CheckNowButton" DockPanel.Dock="Left" Content="{loc:T 'Check now'}" Click="CheckNowButton_Click" />
                    <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" Classes="dim" />
                </DockPanel>

                <StackPanel x:Name="AiPanel" IsVisible="False">
                    <TextBlock Text="{loc:T 'AI voices'}" Classes="section" Margin="0,22,0,0" />
                    <TextBlock x:Name="AiMissingText" Text="{loc:T 'AI mode isn’t installed. Download it from the Voices tab.'}" Classes="dim"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                    <StackPanel x:Name="AiControls">
                        <TextBlock Text="{loc:T 'AI quality'}" Classes="label" Margin="0,10,0,0" />
                        <ComboBox x:Name="AiQualityBox" Margin="0,6,0,0" HorizontalAlignment="Stretch" SelectionChanged="AiQualityBox_SelectionChanged" />
                        <TextBlock Text="{loc:T 'Device'}" Classes="label" Margin="0,14,0,0" />
                        <ComboBox x:Name="AiDeviceBox" Margin="0,6,0,0" HorizontalAlignment="Stretch" SelectionChanged="AiDeviceBox_SelectionChanged" />
                        <CheckBox x:Name="HearAiBox" Margin="0,14,0,0" Click="HearAiBox_Click">
                            <TextBlock Text="{loc:T 'Hear me plays the AI voice itself (it comes a little late, which makes talking harder)'}" TextWrapping="Wrap" />
                        </CheckBox>
                        <DockPanel Margin="0,12,0,0" LastChildFill="True">
                            <Button x:Name="TestPcButton" DockPanel.Dock="Left" Content="{loc:T 'Test my PC'}" Click="TestPcButton_Click" />
                            <TextBlock x:Name="TestPcText" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" Classes="dim" />
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0" LastChildFill="True">
                            <Button x:Name="RemoveAiButton" DockPanel.Dock="Left" Content="{loc:T 'Remove AI mode…'}" Click="RemoveAiButton_Click" />
                            <TextBlock x:Name="AiSizeText" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" Classes="dim" />
                        </DockPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{loc:T 'Hotkeys'}" Classes="section" Margin="0,22,0,0" />
                <Grid x:Name="HotkeyGrid" Margin="0,8,0,0" ColumnDefinitions="*,Auto" />

                <WrapPanel Margin="0,22,0,0">
                    <Button x:Name="SetupAgainButton" Margin="0,0,8,8" Content="{loc:T 'Open setup again'}" Click="SetupAgainButton_Click" />
                    <Button x:Name="CreditsButton" Margin="0,0,8,8" Content="{loc:T 'Credits and licences'}" Click="CreditsButton_Click" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="20,8,20,16" LastChildFill="False">
            <Button x:Name="QuitButton" DockPanel.Dock="Left" Content="{loc:T 'Quit EasyVocal'}" Click="QuitButton_Click"
                    ToolTip.Tip="{loc:T 'Close EasyVocal completely (calls stop getting your voice)'}" />
            <Button x:Name="CloseButton" DockPanel.Dock="Right" MinWidth="96" Theme="{StaticResource AccentButton}"
                    Content="{loc:T 'Close'}" IsDefault="True" IsCancel="True" Click="CancelClick" />
        </DockPanel>
    </Grid>
</loc:AppWindow>
