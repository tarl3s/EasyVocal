<Window x:Class="EasyVocal.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EasyVocal"
        Title="{loc:T 'Settings'}" Width="520" SizeToContent="Height" MinWidth="420" MinHeight="340"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Icon="Assets/EasyVocal.ico"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,8">
                <TextBlock Text="{loc:T 'Audio'}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />

                <TextBlock Text="{loc:T 'Microphone'}" FontWeight="SemiBold" Margin="0,10,0,0" />
                <ComboBox x:Name="MicBox" Margin="0,6,0,0" SelectionChanged="MicBox_SelectionChanged" />
                <TextBlock x:Name="MicProblem" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource Danger}" Margin="0,6,0,0" />

                <TextBlock Text="{loc:T 'Call output'}" FontWeight="SemiBold" Margin="0,14,0,0" />
                <ComboBox x:Name="OutputBox" Margin="0,6,0,0" SelectionChanged="OutputBox_SelectionChanged" />
                <TextBlock Text="{loc:T 'Automatic sends your voice to the virtual microphone (CABLE Input). Change it only if you know why.'}"
                           Foreground="{StaticResource TextDim}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />

                <TextBlock Text="{loc:T 'Headphones for “Hear me”'}" FontWeight="SemiBold" Margin="0,14,0,0" />
                <ComboBox x:Name="MonitorBox" Margin="0,6,0,0" SelectionChanged="MonitorBox_SelectionChanged" />

                <TextBlock Text="{loc:T 'General'}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,22,0,0" />

                <TextBlock Text="{loc:T 'Language'}" FontWeight="SemiBold" Margin="0,10,0,0" />
                <ComboBox x:Name="LanguageBox" Margin="0,6,0,0" SelectionChanged="LanguageBox_SelectionChanged" />
                <TextBlock x:Name="LanguageNote" Text="{loc:T 'The language changes the next time you open EasyVocal.'}"
                           Foreground="{StaticResource TextDim}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />

                <CheckBox x:Name="StartBox" Margin="0,16,0,0" Content="{loc:T 'Start with Windows'}" Click="StartBox_Click" />
                <CheckBox x:Name="AskQuitBox" Margin="0,10,0,0" Content="{loc:T 'Ask before quitting'}" Click="AskQuitBox_Click" />

                <CheckBox x:Name="UpdateBox" Margin="0,10,0,0" Content="{loc:T 'Check for updates when EasyVocal opens'}" Click="UpdateBox_Click" />
                <DockPanel Margin="0,10,0,0" LastChildFill="True">
                    <Button x:Name="CheckNowButton" DockPanel.Dock="Left" Content="{loc:T 'Check now'}" Click="CheckNowButton_Click" />
                    <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextDim}" />
                </DockPanel>

                <TextBlock Text="{loc:T 'Hotkeys'}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,22,0,0" />
                <Grid x:Name="HotkeyGrid" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                </Grid>

                <Button x:Name="SetupAgainButton" HorizontalAlignment="Left" Margin="0,22,0,0" Content="{loc:T 'Open setup again'}"
                        Click="SetupAgainButton_Click" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="20,8,20,16" LastChildFill="False">
            <Button x:Name="CloseButton" DockPanel.Dock="Right" MinWidth="96" Style="{StaticResource AccentButton}"
                    Content="{loc:T 'Close'}" IsDefault="True" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
