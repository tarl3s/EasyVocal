<Window x:Class="EasyVocal.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EasyVocal"
        Title="{loc:T 'EasyVocal setup'}" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="Assets/EasyVocal.ico"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,8">
                <TextBlock Text="{loc:T 'Set up EasyVocal'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                <TextBlock Text="{loc:T 'Three quick steps, then you are ready for your calls.'}" Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />

                <!-- 1. Virtual microphone -->
                <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10"
                        Padding="14" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource Accent}">
                                <TextBlock Text="1" FontWeight="Bold" Foreground="{StaticResource AccentText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{loc:T 'Virtual microphone'}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel x:Name="CableReadyPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="✅" FontFamily="{StaticResource EmojiFont}" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:T 'Virtual microphone ready'}" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel x:Name="CableMissingPanel" Margin="0,10,0,0">
                            <TextBlock Text="{loc:T 'EasyVocal sends your voice to calls through a free virtual microphone called VB-CABLE.'}"
                                       TextWrapping="Wrap" />
                            <DockPanel Margin="0,10,0,0" LastChildFill="True">
                                <Button x:Name="InstallButton" DockPanel.Dock="Left" Style="{StaticResource AccentButton}" MinWidth="96"
                                        Content="{loc:T 'Install'}" Click="InstallButton_Click" />
                                <Border x:Name="ProgressTrack" Height="8" CornerRadius="4" Background="{StaticResource Bg2}" Margin="12,0,0,0"
                                        VerticalAlignment="Center" Visibility="Collapsed" SizeChanged="ProgressTrack_SizeChanged">
                                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="4"
                                            Background="{StaticResource Accent}" />
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="CableStatus" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. Your microphone -->
                <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10"
                        Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource Accent}">
                                <TextBlock Text="2" FontWeight="Bold" Foreground="{StaticResource AccentText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{loc:T 'Your microphone'}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ComboBox x:Name="MicBox" Margin="0,10,0,0" SelectionChanged="MicBox_SelectionChanged" />
                        <TextBlock x:Name="NoMicText" Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Warn}"
                                   Text="{loc:T 'No microphone found. Plug one in and it will show up here.'}" />
                        <Border x:Name="MeterTrack" Height="8" CornerRadius="4" Background="{StaticResource Bg2}" Margin="0,12,0,0"
                                ToolTip="{loc:T 'Your microphone level'}">
                            <Border x:Name="MeterBar" HorizontalAlignment="Left" Width="0" CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#4ADE80" Offset="0" />
                                        <GradientStop Color="#4ADE80" Offset="0.6" />
                                        <GradientStop Color="#FACC15" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                        <TextBlock Text="{loc:T 'Say something: the bar should move.'}" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- 3. Choose it in your app -->
                <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10"
                        Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource Accent}">
                                <TextBlock Text="3" FontWeight="Bold" Foreground="{StaticResource AccentText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{loc:T 'Choose it in your app'}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TabControl x:Name="GuideTabs" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <CheckBox x:Name="StartBox" Margin="2,14,0,0" Content="{loc:T 'Start with Windows (recommended)'}" />
                <TextBlock Text="{loc:T 'EasyVocal then starts hidden in the tray, so your voice is ready for every call.'}"
                           Foreground="{StaticResource TextDim}" FontSize="12" Margin="26,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="20,8,20,16" LastChildFill="False">
            <Button x:Name="DoneButton" DockPanel.Dock="Right" MinWidth="96" Style="{StaticResource AccentButton}"
                    Content="{loc:T 'Done'}" IsDefault="True" Click="DoneButton_Click" />
        </DockPanel>
    </Grid>
</Window>
