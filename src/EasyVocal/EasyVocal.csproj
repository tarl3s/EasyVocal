<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app: one Avalonia UI for Windows, macOS and Linux. Plain net8.0; the platform it runs on is picked at
       start (PlatformFactory.cs): EasyVocal.Platform.Windows on Windows, the macOS/Linux projects next to it later.
       The exe is EasyVocal(.exe). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>EasyVocal</AssemblyName>
    <RootNamespace>EasyVocal</RootNamespace>
    <ApplicationIcon>Assets/EasyVocal.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Release publish: self-contained single file (see tools/Publish-Release.ps1). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- AVLN3001: the windows take the controller in their constructor, so the runtime XAML loader (unused: everything is
         compiled) can't make them. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="EasyVocal.Core.Logging" />
    <Using Include="EasyVocal.Core.Platform" />
    <Using Include="EasyVocal.Core.Update" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Lang\*.json" LogicalName="EasyVocal.Lang.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="EasyVocal.THIRD-PARTY-NOTICES.md" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EasyVocal.UiTests" />
  </ItemGroup>

  <!-- Debug builds run the AI voices without an AI pack's runtime folder: ONNX Runtime's native library from NuGet.
       Release downloads leave it out (the AI pack brings it). -->
  <Import Project="..\EasyVocal.Ai\OnnxRuntime.Native.props" Condition="'$(Configuration)' == 'Debug'" />

  <ItemGroup>
    <ProjectReference Include="..\EasyVocal.Core\EasyVocal.Core.csproj" />
    <!-- The AI voices (ONNX Runtime's managed API; its native library comes with the AI pack). -->
    <ProjectReference Include="..\EasyVocal.Ai\EasyVocal.Ai.csproj" />
    <!-- Windows-only code (marked SupportedOSPlatform("windows")): used only behind OperatingSystem.IsWindows(). -->
    <ProjectReference Include="..\EasyVocal.Platform.Windows\EasyVocal.Platform.Windows.csproj" />
    <!-- macOS and Linux (marked SupportedOSPlatform too): used only behind OperatingSystem.IsMacOS() / IsLinux(). -->
    <ProjectReference Include="..\EasyVocal.Platform.MacOS\EasyVocal.Platform.MacOS.csproj" />
    <ProjectReference Include="..\EasyVocal.Platform.Linux\EasyVocal.Platform.Linux.csproj" />
  </ItemGroup>

</Project>
