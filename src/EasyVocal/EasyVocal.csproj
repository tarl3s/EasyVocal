<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets/EasyVocal.ico</ApplicationIcon>
    <!-- Release publish: self-contained single file (see tools/Publish-Release.ps1). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used by Tray.cs, which names its types in full: keep WPF's Application, Button, ... unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="EasyVocal.Core.Logging" />
    <Using Include="EasyVocal.Core.Platform" />
    <Using Include="EasyVocal.Core.Update" />
    <Using Include="EasyVocal.Platform.Windows" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Lang\*.json" LogicalName="EasyVocal.Lang.%(Filename)%(Extension)" />
    <Resource Include="Assets\EasyVocal.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyVocal.Core\EasyVocal.Core.csproj" />
    <ProjectReference Include="..\EasyVocal.Platform.Windows\EasyVocal.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
