<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette (dark). Text on Accent uses AccentText; every text colour is >= 4.5:1 on the backgrounds it is used on. -->
    <SolidColorBrush x:Key="Bg0" Color="#16181D" />
    <SolidColorBrush x:Key="Bg1" Color="#1D2027" />
    <SolidColorBrush x:Key="Bg2" Color="#22262E" />
    <SolidColorBrush x:Key="Bg3" Color="#2B303A" />
    <SolidColorBrush x:Key="Hover" Color="#323845" />
    <SolidColorBrush x:Key="Border" Color="#3A404C" />
    <SolidColorBrush x:Key="Text" Color="#E8E8EA" />
    <SolidColorBrush x:Key="TextDim" Color="#A3A9B4" />
    <SolidColorBrush x:Key="Accent" Color="#4ADE80" />
    <SolidColorBrush x:Key="AccentHover" Color="#6EE7A0" />
    <SolidColorBrush x:Key="AccentText" Color="#0B1A10" />
    <SolidColorBrush x:Key="Danger" Color="#F87171" />
    <SolidColorBrush x:Key="DangerText" Color="#2A0B0B" />
    <SolidColorBrush x:Key="Warn" Color="#FACC15" />
    <SolidColorBrush x:Key="WarnText" Color="#241C02" />
    <SolidColorBrush x:Key="Selection" Color="#4A4ADE80" />
    <!-- Behind an emoji: dark glyphs (🎵 🎶 🦇) stay visible on the dark cards, grey ones (🎧 🔇) on green or red. -->
    <SolidColorBrush x:Key="EmojiPlate" Color="#30FFFFFF" />
    <SolidColorBrush x:Key="Scrim" Color="#B316181D" />
    <SolidColorBrush x:Key="EmojiPlateOnColor" Color="#590B1A10" />
    <!-- The OS's colour emoji font where there is one (Windows, macOS, most Linux desktops); otherwise whatever has the glyph. -->
    <!-- The UI font: Segoe UI on Windows; elsewhere the first one installed, else the system default. -->
    <FontFamily x:Key="UiFont">Segoe UI, .AppleSystemUIFont, Helvetica Neue, Ubuntu, Cantarell, Noto Sans, DejaVu Sans</FontFamily>
    <FontFamily x:Key="EmojiFont">Segoe UI Emoji, Apple Color Emoji, Noto Color Emoji, Twemoji, EmojiOne Color</FontFamily>
    <!-- The mic level bar: green, turning yellow when loud. -->
    <LinearGradientBrush x:Key="MeterFill" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#4ADE80" Offset="0" />
        <GradientStop Color="#4ADE80" Offset="0.6" />
        <GradientStop Color="#FACC15" Offset="1" />
    </LinearGradientBrush>

    <!-- Fluent keeps TextBox, menus and the window chrome; these put it on the palette above. -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>
    <Color x:Key="SystemAccentColor">#4ADE80</Color>
    <Color x:Key="SystemAccentColorLight1">#6EE7A0</Color>
    <Color x:Key="SystemAccentColorLight2">#86EFAC</Color>
    <Color x:Key="SystemAccentColorLight3">#BBF7D0</Color>
    <Color x:Key="SystemAccentColorDark1">#22C55E</Color>
    <Color x:Key="SystemAccentColorDark2">#16A34A</Color>
    <Color x:Key="SystemAccentColorDark3">#15803D</Color>
    <SolidColorBrush x:Key="TextControlForeground" Color="#E8E8EA" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E8E8EA" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E8E8EA" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#A3A9B4" />
    <SolidColorBrush x:Key="TextControlBackground" Color="#1D2027" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1D2027" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1D2027" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#1D2027" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3A404C" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#4ADE80" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#4ADE80" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#3A404C" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#A3A9B4" />
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#4ADE80" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#0B1A10" />
    <SolidColorBrush x:Key="TextControlButtonForeground" Color="#A3A9B4" />
    <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#E8E8EA" />
    <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#22262E" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#3A404C" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#323845" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#2B303A" />
    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#E8E8EA" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#E8E8EA" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#E8E8EA" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#A3A9B4" />
    <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#3A404C" />
    <SolidColorBrush x:Key="MenuFlyoutSeparatorThemeBrush" Color="#3A404C" />

    <!-- Keyboard focus: an accent outline instead of the default one. -->
    <FocusAdornerTemplate x:Key="FocusRing">
        <Border Margin="-2" CornerRadius="8" BorderBrush="{StaticResource Accent}" BorderThickness="2" />
    </FocusAdornerTemplate>

    <!-- ===== Buttons ===== -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Bg3}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True" />
            </ControlTemplate>
        </Setter>
        <!-- Hover/pressed colours are on Background itself, so a derived theme (AccentButton) can replace them. -->
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{StaticResource Hover}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{StaticResource Bg2}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="{StaticResource AccentText}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentHover}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{StaticResource Accent}" />
        </Style>
    </ControlTheme>

    <!-- A flat button with no frame (icons, links). -->
    <ControlTheme x:Key="FlatButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8,4" />
    </ControlTheme>

    <!-- A big emoji + name button in the voice and sound grids (content built in code). -->
    <ControlTheme x:Key="CardButton" TargetType="Button">
        <Setter Property="Width" Value="110" />
        <Setter Property="Height" Value="96" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Background" Value="{StaticResource Bg2}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusAdorner" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Content="{TemplateBinding Content}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Hover}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg3}" />
        </Style>
    </ControlTheme>

    <!-- The dashed "＋ New filter / ＋ Add sound" card. -->
    <ControlTheme x:Key="AddCardButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Rectangle Name="Bd" RadiusX="8" RadiusY="8" Fill="{TemplateBinding Background}" Stroke="{StaticResource Border}"
                               StrokeThickness="2" StrokeDashArray="3,2" />
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Rectangle#Bd">
            <Setter Property="Fill" Value="{StaticResource Bg1}" />
            <Setter Property="Stroke" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </ControlTheme>

    <!-- A tool-like small button in the audio editor's groups. -->
    <ControlTheme x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="Padding" Value="10,5" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource Bg3}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="-2" CornerRadius="18" BorderBrush="{StaticResource Accent}" BorderThickness="2" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Content="{TemplateBinding Content}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{StaticResource Hover}" />
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource AccentText}" />
        </Style>
        <Style Selector="^:checked:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentHover}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <!-- Checked = a warning (e.g. the microphone is muted). -->
    <ControlTheme x:Key="DangerToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Style Selector="^:checked">
            <Setter Property="Background" Value="{StaticResource Danger}" />
            <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
            <Setter Property="Foreground" Value="{StaticResource DangerText}" />
        </Style>
        <Style Selector="^:checked:pointerover">
            <Setter Property="Background" Value="{StaticResource Danger}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*" Background="{TemplateBinding Background}">
                    <Border Name="Box" Width="18" Height="18" CornerRadius="4" Background="{StaticResource Bg1}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1" VerticalAlignment="Center">
                        <Path Name="Mark" Data="M3,9 L7,13 L15,4" Stroke="{StaticResource AccentText}" StrokeThickness="2.2"
                              IsVisible="False" Margin="-1" />
                    </Border>
                    <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                      Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"
                                      IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Box">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="^:checked /template/ Border#Box">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="^:checked /template/ Path#Mark">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <!-- ===== Tabs (pills, as in the approved layout) ===== -->
    <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel Background="{TemplateBinding Background}">
                    <ItemsPresenter Name="PART_ItemsPresenter" DockPanel.Dock="Top" Margin="0,0,0,10"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                    <ContentPresenter Name="PART_SelectedContentHost" Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding SelectedContent}"
                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Bg2}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="-2" CornerRadius="18" BorderBrush="{StaticResource Accent}" BorderThickness="2" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="16"
                                  Padding="{TemplateBinding Padding}"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{StaticResource Hover}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource AccentText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </ControlTheme>

    <!-- ===== Tooltips ===== -->
    <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Bg3}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  TextWrapping="Wrap" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ===== Combo boxes ===== -->
    <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Bg1}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,4,28,4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="FocusAdorner" Value="{StaticResource FocusRing}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Panel>
                            <ContentControl Name="ContentPresenter" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                            HorizontalAlignment="Left" IsHitTestVisible="False"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding ItemTemplate}" />
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M0,0 L4,4 L8,0"
                                  Stroke="{StaticResource TextDim}" StrokeThickness="1.5" IsHitTestVisible="False" />
                        </Panel>
                    </Border>
                    <Popup Name="PART_Popup" WindowManagerAddShadowHint="False" IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                           MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                           MaxHeight="{TemplateBinding MaxDropDownHeight}" Placement="BottomEdgeAlignedLeft"
                           IsLightDismissEnabled="True" InheritsTransform="True">
                        <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="6" Padding="4">
                            <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                          VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="^:dropdownopen /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="4"
                                  Padding="{TemplateBinding Padding}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="Center" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{StaticResource Bg3}" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{StaticResource Hover}" />
        </Style>
    </ControlTheme>

    <!-- ===== Slider (horizontal) ===== -->
    <ControlTheme x:Key="SliderTrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
            <ControlTemplate>
                <Ellipse Name="Dot" Fill="{StaticResource Accent}" Stroke="{StaticResource Bg0}" StrokeThickness="2" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Ellipse#Dot">
            <Setter Property="Fill" Value="{StaticResource AccentHover}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent" MinHeight="{TemplateBinding MinHeight}">
                    <Border Height="4" CornerRadius="2" Background="{StaticResource Bg3}" VerticalAlignment="Center" Margin="9,0" />
                    <Track Name="PART_Track" Orientation="Horizontal"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource SliderTrackButton}" />
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource SliderTrackButton}" />
                        </Track.IncreaseButton>
                        <Thumb Name="thumb" Theme="{StaticResource SliderThumb}" />
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <!-- ===== Scroll bars (slim, always there when needed) ===== -->
    <ControlTheme x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{StaticResource Bg3}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="4" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{StaticResource Border}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <Track Name="PART_Track" Margin="2"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"
                           Orientation="{TemplateBinding Orientation}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource SliderTrackButton}" />
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource SliderTrackButton}" />
                        </Track.IncreaseButton>
                        <Thumb Name="thumb" Theme="{StaticResource ScrollThumb}" />
                    </Track>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:vertical">
            <Setter Property="Width" Value="10" />
        </Style>
        <Style Selector="^:vertical /template/ Track#PART_Track">
            <Setter Property="IsDirectionReversed" Value="True" />
        </Style>
        <Style Selector="^:horizontal">
            <Setter Property="Height" Value="10" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ScrollViewer}" TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
                    <ScrollContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}" />
                    <ScrollBar Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Focusable="False" />
                    <ScrollBar Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Focusable="False" />
                    <Panel Name="PART_ScrollBarsSeparator" Grid.Row="1" Grid.Column="1" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
