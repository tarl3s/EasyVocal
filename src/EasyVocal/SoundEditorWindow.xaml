<Window x:Class="EasyVocal.SoundEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EasyVocal"
        Title="{loc:T 'Sound'}" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Icon="Assets/EasyVocal.ico" AllowDrop="True"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="20,16,20,16" AllowDrop="True">
        <TextBlock Text="{loc:T 'Sound file'}" FontWeight="SemiBold" />
        <Border Margin="0,6,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource Bg1}" AllowDrop="True"
                BorderBrush="{StaticResource Border}" BorderThickness="1">
            <DockPanel>
                <Button x:Name="ChooseButton" DockPanel.Dock="Right" Margin="12,0,0,0" Content="{loc:T 'Choose file…'}" Click="ChooseButton_Click" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FileText" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DropHint" Text="{loc:T 'You can also drag a sound file onto this window.'}"
                               Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock x:Name="StatusText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0" />

        <TextBlock Text="{loc:T 'Name'}" FontWeight="SemiBold" Margin="0,16,0,0" />
        <TextBox x:Name="NameBox" MaxLength="30" Margin="0,6,0,0" TextChanged="NameBox_TextChanged" />

        <TextBlock Text="{loc:T 'Emoji'}" FontWeight="SemiBold" Margin="0,14,0,0" />
        <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8"
                Padding="8,8,4,4" Margin="0,6,0,0">
            <ContentControl x:Name="EmojiHost" />
        </Border>

        <TextBlock Text="{loc:T 'Volume'}" FontWeight="SemiBold" Margin="0,14,0,0" />
        <DockPanel Margin="0,4,0,0">
            <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" SmallChange="0.02" LargeChange="0.1" VerticalAlignment="Center"
                    ValueChanged="VolumeSlider_ValueChanged" />
        </DockPanel>

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="PreviewButton" DockPanel.Dock="Left" Click="PreviewButton_Click" IsEnabled="False"
                    ToolTip="{loc:T 'Hear it on your headphones only'}" />
            <Button x:Name="HotkeyButton" DockPanel.Dock="Left" Margin="8,0,0,0" Click="HotkeyButton_Click" />
        </DockPanel>

        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="80" Content="{loc:T 'Cancel'}" IsCancel="True" />
            <Button x:Name="SaveButton" DockPanel.Dock="Right" MinWidth="80" Style="{StaticResource AccentButton}" Content="{loc:T 'Save'}"
                    Click="SaveButton_Click" />
        </DockPanel>
    </StackPanel>
</Window>
