<Window x:Class="EasyVocal.FilterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EasyVocal"
        Title="{loc:T 'Voice filter'}" Width="500" SizeToContent="Height" MinHeight="300" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Icon="Assets/EasyVocal.ico"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,8">
                <TextBlock Text="{loc:T 'Name'}" FontWeight="SemiBold" />
                <TextBox x:Name="NameBox" MaxLength="30" Margin="0,6,0,0" TextChanged="NameBox_TextChanged" />

                <TextBlock Text="{loc:T 'Emoji'}" FontWeight="SemiBold" Margin="0,14,0,0" />
                <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8"
                        Padding="8,8,4,4" Margin="0,6,0,0">
                    <ContentControl x:Name="EmojiHost" />
                </Border>

                <TextBlock Text="{loc:T 'Start from'}" FontWeight="SemiBold" Margin="0,14,0,0" />
                <ComboBox x:Name="StartBox" Margin="0,6,0,0" SelectionChanged="StartBox_SelectionChanged" />

                <TextBlock Text="{loc:T 'Your voice'}" FontWeight="SemiBold" Margin="0,18,0,0" />
                <StackPanel x:Name="SliderPanel" Margin="0,2,0,0" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="20,8,20,16" LastChildFill="False">
            <Button x:Name="ResetButton" DockPanel.Dock="Left" Click="ResetButton_Click"
                    ToolTip="{loc:T 'Put the sliders back where they started'}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↺" Margin="0,0,6,0" />
                    <TextBlock Text="{loc:T 'Reset'}" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="80" Content="{loc:T 'Cancel'}" IsCancel="True" />
            <Button x:Name="SaveButton" DockPanel.Dock="Right" MinWidth="80" Style="{StaticResource AccentButton}" Click="SaveButton_Click" />
        </DockPanel>
    </Grid>
</Window>
