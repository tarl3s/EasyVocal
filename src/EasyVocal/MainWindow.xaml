<Window x:Class="EasyVocal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:EasyVocal"
        Title="EasyVocal" Width="560" Height="620" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterScreen" Icon="Assets/EasyVocal.ico"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar: name, ON/OFF, mic level, mute, hear me, settings -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="EasyVocal" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <ToggleButton x:Name="OnOffButton" Grid.Column="1" MinWidth="76" Padding="14,6" FontWeight="SemiBold"
                          Click="OnOffButton_Click" ToolTip="{loc:T 'Turn the voice filter on or off. Off sends your normal voice.'}" />
            <Border x:Name="MeterTrack" Grid.Column="2" Height="8" CornerRadius="4" Background="{StaticResource Bg2}"
                    Margin="12,0" VerticalAlignment="Center" ToolTip="{loc:T 'Your microphone level'}">
                <Border x:Name="MeterBar" HorizontalAlignment="Left" Width="0" CornerRadius="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#4ADE80" Offset="0" />
                            <GradientStop Color="#4ADE80" Offset="0.6" />
                            <GradientStop Color="#FACC15" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Border>
            <ToggleButton x:Name="MuteButton" Grid.Column="3" Style="{StaticResource DangerToggle}" Padding="10,6"
                          Margin="0,0,6,0" Click="MuteButton_Click" ToolTip="{loc:T 'Mute your microphone'}">
                <TextBlock Text="🔇" FontFamily="{StaticResource EmojiFont}" />
            </ToggleButton>
            <ToggleButton x:Name="HearMeButton" Grid.Column="4" Padding="12,6" Margin="0,0,6,0" Click="HearMeButton_Click"
                          ToolTip="{loc:T 'Hear your own voice in your headphones, to try the voices'}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🎧" FontFamily="{StaticResource EmojiFont}" Margin="0,0,6,0" />
                    <TextBlock Text="{loc:T 'Hear me'}" />
                </StackPanel>
            </ToggleButton>
            <Button x:Name="SettingsButton" Grid.Column="5" Style="{StaticResource FlatButton}" FontSize="18" Padding="6,2"
                    Click="SettingsButton_Click" ToolTip="{loc:T 'Settings'}">
                <TextBlock Text="⚙" FontFamily="{StaticResource EmojiFont}" />
            </Button>
        </Grid>

        <!-- Shown while the audio isn't running -->
        <Border x:Name="Banner" Grid.Row="1" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,8" CornerRadius="8"
                Background="{StaticResource Bg2}" BorderBrush="{StaticResource Danger}" BorderThickness="1">
            <DockPanel>
                <Button x:Name="FixButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Margin="12,0,0,0"
                        Content="{loc:T 'Fix'}" Click="FixButton_Click" />
                <TextBlock x:Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TextBlock x:Name="HotkeyNote" Grid.Row="2" Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource Warn}" />

        <TabControl x:Name="Tabs" Grid.Row="3" Margin="0,14,0,0">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎭" FontFamily="{StaticResource EmojiFont}" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:T 'Voices'}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid TextElement.Foreground="{StaticResource Text}" TextElement.FontWeight="Normal">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="VoicePanel" />
                    </ScrollViewer>
                    <DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="False">
                        <CheckBox x:Name="ShowHiddenVoices" DockPanel.Dock="Right" Content="{loc:T 'Show hidden items'}"
                                  Click="ShowHidden_Click" />
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔊" FontFamily="{StaticResource EmojiFont}" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:T 'Sounds'}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid TextElement.Foreground="{StaticResource Text}" TextElement.FontWeight="Normal">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="SoundPanel" />
                    </ScrollViewer>
                    <DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="False">
                        <Button x:Name="StopAllButton" DockPanel.Dock="Left" Click="StopAllButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="■" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:T 'Stop all sounds'}" />
                            </StackPanel>
                        </Button>
                        <CheckBox x:Name="ShowHiddenSounds" DockPanel.Dock="Right" VerticalAlignment="Center"
                                  Content="{loc:T 'Show hidden items'}" Click="ShowHidden_Click" />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
