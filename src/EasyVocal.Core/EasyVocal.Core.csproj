<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Portable: Windows, macOS and Linux. Windows-only code lives in EasyVocal.Platform.Windows. -->
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- NAudio.Core is NAudio's managed, cross-platform part (WAV/AIFF, sample providers, resampler); no device code. -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="NLayer" Version="3.0.0" />
  </ItemGroup>

</Project>
